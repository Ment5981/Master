# Copy to server/.env (never commit the populated file).
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# Optional WebSocket proxy, for example http://127.0.0.1:7890
QWEN_HTTPS_PROXY=
# Default JSON Object + local strict Zod validation. Set true ONLY for a selected
# model whose current regional docs explicitly support JSON Schema response_format.
QWEN_JSON_SCHEMA=false
MASTER_GATEWAY_PORT=4318
MASTER_GATEWAY_TOKEN=
MASTER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
MASTER_AI_REQUESTS_PER_HOUR=60
MASTER_AI_CONCURRENCY=2
MASTER_AI_TIMEOUT_MS=60000
