{
  "name": "master",
  "private": true,
  "version": "0.2.0-alpha.2",
  "description": "Master 时间思维导图与节奏管理",
  "author": "Ment5981",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "npm run gateway:build && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "desktop:build": "npm run build && npm run gateway:build && electron-builder --win",
    "desktop:preview": "electron .",
    "mobile:sync": "npm run build && cap sync",
    "android:open": "npm run mobile:sync && cap open android",
    "android:run": "npm run build && cap run android",
    "android:build:debug": "node scripts/android-build.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "lint": "oxlint",
    "test": "vitest run",
    "test:gateway": "vitest run --config server/vitest.config.ts --configLoader native",
    "server": "node --env-file-if-exists=server/.env --import tsx server/index.ts",
    "gateway:build": "node server/build-desktop.mjs",
    "typecheck:gateway": "tsc -p server/tsconfig.json",
    "qa:v2": "node scripts/v2-qa.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:mobile": "node scripts/mobile-visual-qa.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.118",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "fastify": "^5.12.5",
    "https-proxy-agent": "7.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.62.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.master.time",
    "productName": "Master",
    "artifactName": "Master-Setup-${version}.${ext}",
    "directories": {
      "output": "release-v2"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/v2/core/runtime.mjs",
      "!electron/*.test.*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Master"
    }
  }
}
